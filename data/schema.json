{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/folio-ledger.schema.json",
  "title": "FOLIO private ledger export",
  "type": "object",
  "required": ["schemaVersion", "publicSource", "privateLedger", "privateMarket"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "publicSource": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "schemaVersion": { "type": ["integer", "null"] },
        "updatedAt": { "type": "string" }
      },
      "additionalProperties": false
    },
    "privateLedger": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "country", "currency", "denomination", "status"],
        "properties": {
          "id": { "type": "string" },
          "sourceItemId": { "type": "string", "description": "World Banknote Archive items[].id used to join a private overlay" },
          "country": { "type": "string" },
          "currency": { "type": "string" },
          "denomination": { "type": "string" },
          "year": { "type": "string" },
          "catalogNo": { "type": "string" },
          "condition": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 0 },
          "status": { "type": "string" },
          "acquisitionCost": { "type": "number", "minimum": 0 },
          "acquisitionPurpose": { "type": "string" },
          "salePrice": { "type": "number", "minimum": 0 },
          "feesShipping": { "type": "number", "minimum": 0 },
          "soldAt": { "type": "string" },
          "privateMemo": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "privateMarket": {
      "type": "object",
      "required": ["observations", "costs", "decisions"],
      "properties": {
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "candidateId", "marketplace", "matchLevel", "soldPrice"],
            "properties": {
              "id": { "type": "string" },
              "candidateId": { "type": "string" },
              "marketplace": { "type": "string" },
              "matchLevel": { "enum": ["exact", "close", "theme"] },
              "soldPrice": { "type": "number", "minimum": 0 },
              "shippingPrice": { "type": "number", "minimum": 0 },
              "soldAt": { "type": "string" },
              "listingUrl": { "type": "string" },
              "recordedAt": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "costs": { "type": "object", "additionalProperties": { "type": "object" } },
        "decisions": { "type": "object", "additionalProperties": { "enum": ["proposed", "accepted"] } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
