{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/banknote-ledger.schema.json",
  "title": "Banknote Circulation Ledger Export",
  "type": "object",
  "required": ["schemaVersion", "banknotes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "banknotes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "country", "currency", "denomination", "quantity", "status"],
        "properties": {
          "id": { "type": "string" },
          "country": { "type": "string" },
          "issuerRegime": { "type": "string" },
          "currency": { "type": "string" },
          "denomination": { "type": "string" },
          "year": { "type": "string" },
          "catalogNo": { "type": "string" },
          "serialNo": { "type": "string" },
          "condition": { "enum": ["UNC", "AU", "XF", "VF", "F", "G"] },
          "quantity": { "type": "integer", "minimum": 0 },
          "acquiredAt": { "type": "string", "format": "date" },
          "acquisitionCost": { "type": "number", "minimum": 0 },
          "acquisitionPurpose": { "enum": ["自己コレクション", "セット購入に伴う余剰", "交換", "贈与等", "販売を予定した取得"] },
          "status": { "enum": ["Collection", "Reserve", "Sale Candidate", "Listed", "Sold"] },
          "salePrice": { "type": "number", "minimum": 0 },
          "feesShipping": { "type": "number", "minimum": 0 },
          "soldAt": { "type": "string" },
          "imageFront": { "type": "string" },
          "imageBack": { "type": "string" },
          "privateMemo": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
