{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/folio-ledger.schema.json",
  "title": "FOLIO private ledger export",
  "type": "object",
  "required": ["schemaVersion", "publicSource", "privateLedger"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "publicSource": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "schemaVersion": { "type": ["integer", "null"] },
        "updatedAt": { "type": "string" }
      },
      "additionalProperties": false
    },
    "privateLedger": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "country", "currency", "denomination", "status"],
        "properties": {
          "id": { "type": "string" },
          "sourceItemId": { "type": "string", "description": "World Banknote Archive items[].id used to join a private overlay" },
          "country": { "type": "string" },
          "currency": { "type": "string" },
          "denomination": { "type": "string" },
          "year": { "type": "string" },
          "catalogNo": { "type": "string" },
          "condition": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 0 },
          "status": { "type": "string" },
          "acquisitionCost": { "type": "number", "minimum": 0 },
          "acquisitionPurpose": { "type": "string" },
          "salePrice": { "type": "number", "minimum": 0 },
          "feesShipping": { "type": "number", "minimum": 0 },
          "soldAt": { "type": "string" },
          "privateMemo": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
